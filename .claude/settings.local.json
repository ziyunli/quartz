{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(npx quartz build:*)",
      "Bash(chmod:*)",
      "Bash(npx prettier --version)",
      "Bash(npx prettier:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(./scripts/setup.sh:*)",
      "Bash(git config:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [],
    "ask": []
  },
  "outputStyle": "Learning",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.md) cd /Volumes/HyperMac/Dropbox/Vaults/quartz && npx prettier --write --ignore-path /dev/null \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting with prettier..."
          }
        ]
      }
    ]
  }
}
